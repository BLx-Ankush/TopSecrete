# ============================================================
# Alice Voice Assistant — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your actual keys
# DO NOT commit the .env file to Git — it contains secrets
# ============================================================


# ── LiveKit Configuration (Required) ────────────────────────
# Get your credentials from: https://cloud.livekit.io/
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
LIVEKIT_URL=wss://your-project.livekit.cloud


# ── OpenAI API (Required for voice and agents) ──────────────
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here


# ── Google Gemini API (Optional - Alternative LLM) ──────────
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here


# ── Mem0 Persistent Memory (Optional) ───────────────────────
# Get your key from: https://app.mem0.ai/
MEM0_API_KEY=your_mem0_api_key_here


# ── N8N MCP Server (Optional) ───────────────────────────────
N8N_MCP_SERVER_URL=


# ── Neural Turn Detection — Deepgram (Optional but Recommended) ──
# Get your key from: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ── Neural Turn Detection — AssemblyAI (Optional) ───────────
# Get your key from: https://www.assemblyai.com/dashboard/
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ── STT Provider Selection: "deepgram" or "assemblyai" ──────
STT_PROVIDER=deepgram


# ── VAD Configuration ───────────────────────────────────────
# Silence threshold in ms (300–500ms recommended, default 400ms)
VAD_SILENCE_THRESHOLD_MS=400


# ── STT Audio Pipeline (match LiveKit — do not change) ──────
STT_SAMPLE_RATE=24000
STT_ENCODING=pcm_s16le
STT_CHANNELS=1
STT_CONNECTION_TIMEOUT_S=10
STT_RECONNECT_ATTEMPTS=3
STT_ENABLE_END_OF_UTTERANCE=true
