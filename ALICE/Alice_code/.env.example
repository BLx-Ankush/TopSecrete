# LiveKit Configuration
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
LIVEKIT_URL=wss://your-livekit-url.livekit.cloud

# Google Gemini API key - gemini-2.0-flash
GOOGLE_API_KEY=your_google_api_key_here

# Mem0 API Key (for persistent memory)
MEM0_API_KEY=your_mem0_api_key_here

# N8N MCP Server URL (optional)
N8N_MCP_SERVER_URL=

# Voice Activity Detection (VAD) Configuration
# Silence threshold in milliseconds (300-500ms recommended)
# Default: 400ms (optimal for natural turn-taking)
# Lower values (300ms): Faster response, may interrupt thinking pauses
# Higher values (500ms): More patient, waits for longer pauses
VAD_SILENCE_THRESHOLD_MS=400

# STT Provider Configuration (for Neural Turn Detection)
# Provider selection: "assemblyai" or "deepgram"
STT_PROVIDER=assemblyai

# AssemblyAI API Key (required if STT_PROVIDER=assemblyai)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Deepgram API Key (required if STT_PROVIDER=deepgram)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# STT Audio Configuration (should match LiveKit audio pipeline)
STT_SAMPLE_RATE=24000
STT_ENCODING=pcm_s16le
STT_CHANNELS=1

# STT Connection Configuration
STT_CONNECTION_TIMEOUT_S=10
STT_RECONNECT_ATTEMPTS=3
STT_ENABLE_END_OF_UTTERANCE=true

# ──────────────────────────────────────────────────────────
# Security hardening (optional — sensible local defaults exist)
# ──────────────────────────────────────────────────────────
# SHA-256 hash of the launcher code used by alice_trigger.py.
# Generate: python -c "import hashlib;print(hashlib.sha256(('alice-launch:'+input()).encode()).hexdigest())"
# If unset, the launcher guides a first-run setup and stores the hash locally.
ALICE_LAUNCH_CODE_HASH=

# Optional explicit HMAC key for signing RL memory/checkpoint files.
# If unset, a machine-local key file is generated automatically.
ALICE_RL_HMAC_KEY=

# ──────────────────────────────────────────────────────────
# Hardware (Raspberry Pi servo / ultrasonic) — optional
# ──────────────────────────────────────────────────────────
# Address of the Pi HTTP controller. Defaults to 127.0.0.1 (fails safe).
ALICE_PI_IP=
ALICE_PI_PORT=5000
ALICE_PI_ULTRASONIC_PATH=/ultrasonic
